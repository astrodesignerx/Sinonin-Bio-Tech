# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Not `/node_modules`: that is root-only, and the studio workspace has its own.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tool caches
.opencode/

# local-only secrets (never commit)
.github-token

# Source masters. The raw video these clips were cut from lives outside the
# repo (see Content/README.md) — the web-ready encodes in public/videos are
# what the site actually ships, and they are a fiftieth of the size.
/Content/*.mp4

# sanity studio (generated)
/studio/.sanity/
/studio/dist/

# migration scratch
/migration-preview.json
/copy-migration-preview.json
